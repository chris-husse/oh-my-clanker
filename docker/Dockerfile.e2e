# E2E image: every test gets a fresh container of this. The container IS the
# sandbox — no host state. API keys enter as runtime env; account auth comes
# from a dedicated named volume and is copied into an ephemeral CODEX_HOME.
#
# --- Task 14 / Step 1: worktrunk distribution (recorded findings) ---
# `cargo search worktrunk` hits crates.io directly:
#   worktrunk = "0.68.0"   # A CLI for Git worktree management, designed for
#                          # parallel AI agent workflows
# Upstream is https://github.com/max-sixty/worktrunk. Its GitHub Releases
# (confirmed via `gh`/API against the `v0.68.0` tag) ship prebuilt *static*
# (musl) Linux binaries per version, each with a sibling `.sha256`:
#   worktrunk-x86_64-unknown-linux-musl.tar.xz
#   worktrunk-aarch64-unknown-linux-musl.tar.xz
# Both were downloaded and their sha256 verified locally against the
# published `.sha256` files during Task 14 research. A static-binary
# curl+tar install needs no Rust toolchain and no compilation, so it
# replaces the `rust:1-slim` / `cargo install worktrunk --locked` fallback
# stage from the original task brief — materially faster and simpler for an
# image every test rebuilds/pulls. That fallback still works if this ever
# needs reverting: add back a `FROM rust:1-slim AS wtbuild` stage running
# `cargo install worktrunk --locked` and `COPY --from=wtbuild
# /usr/local/cargo/bin/wt /usr/local/bin/wt`.
# Checksums below are pinned to v0.68.0 — bump WORKTRUNK_VERSION and both
# sha256 values together when upgrading.

# Pinned minor (spec 2026-10-27 Decision 7): GitNexus `engines` is
# ^22.18.0 || >=24.11.0 and its embedding-runtime loader needs
# module.registerHooks (Node >= 22.15); the floating node:22 tag could drift
# below either. Bump deliberately, together with the pre-bake below.
FROM node:22.23.4-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
# make/g++: tree-sitter grammar packages compile via node-gyp during the
# GitNexus prebake when no prebuilt binary exists for this platform.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 curl ca-certificates xz-utils make g++ \
    && rm -rf /var/lib/apt/lists/*

# uv
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# The supported provider CLIs. Pin Codex to the plugin commands verified in this
# harness; 0.144.5 only registered marketplaces and did not install plugins.
# Claude 2.1.281 enforces declared marketplace sources; 2.1.286 is the version on
# which `plugin list --available` was verified to EXCLUDE installed plugins
# (2026-10-01) — the behaviour omc's live-config proof must not depend on.
ARG CODEX_VERSION=0.156.1
ARG CLAUDE_VERSION=2.1.286
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_VERSION} @openai/codex@${CODEX_VERSION}

# wt (worktrunk) — prebuilt static musl release binary (see note above)
ARG WORKTRUNK_VERSION=0.68.0
ARG TARGETARCH
# The fork merge the E2E image indexes with carries the wiki-regroup and
# copied-index fixes (chris-husse/GitNexus PR #4), piped progress lines and
# LLM heartbeat (PR #5), output-aware wiki grouping (PR #6), split-on-truncation
# grouping (PR #7) and the tracked-only walker (PR #8: the index and wiki cover
# `git ls-files` only, no untracked files or submodule trees). See
# docs/superpowers/specs/2026-10-06-fix-watch-docs-grouping-huge-projects-design.md and
# docs/superpowers/specs/2026-10-07-scope-wiki-generation-to-tracked-files-design.md.
# The fork's 2026-10-28 rebase onto upstream main adds upstream #3693 (`query`
# reaps its embedding sidecar), without which `query` never exits once an index
# has vectors (see docs/superpowers/specs/2026-10-27-enable-embeddings-for-gitnexus-design.md).
# d8683be6 on top of it serializes npm install scripts (gitnexus/.npmrc
# foreground-scripts=true): on linux-arm64 the tree-sitter-typescript build and
# its nested tree-sitter-javascript build otherwise race on node-addon-api.
ARG GITNEXUS_REF=d8683be63a1f061ef88d993d4446a63144405e57
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) WT_TARGET=x86_64-unknown-linux-musl; \
             WT_SHA256=3378ee6a63ca438ac60687c5e6204e06ce694fed41ad57ef6aa54451b10231ed ;; \
      arm64) WT_TARGET=aarch64-unknown-linux-musl; \
             WT_SHA256=c03c58053a0b68849a9238fcc50271804c63e885d1ef1b3f539b2be44be26cdb ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -LsSf -o /tmp/wt.tar.xz \
      "https://github.com/max-sixty/worktrunk/releases/download/v${WORKTRUNK_VERSION}/worktrunk-${WT_TARGET}.tar.xz"; \
    echo "${WT_SHA256}  /tmp/wt.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/wt.tar.xz -C /tmp; \
    install -m 0755 "/tmp/worktrunk-${WT_TARGET}/wt" /usr/local/bin/wt; \
    rm -rf /tmp/wt.tar.xz "/tmp/worktrunk-${WT_TARGET}"

# Pre-bake the GitNexus dependency (approved source only) into ~/.omc so the
# gitnexus E2E tests don't pay the clone+npm+tsc build per test. Placed BEFORE
# `COPY . /repo` so the layer caches across repo changes. gitnexus-shared is a
# plain sibling (not a workspace): its deps must install FIRST or the main
# build dies looking for its tsc — same order gitnexus-ensure prescribes.
# GITNEXUS_SKIP_OPTIONAL_GRAMMARS: optional tree-sitter grammars source-build
# with node-gyp (needs make/g++, absent from the slim image). The chicken's E2E
# used the same skip; production installs on dev machines build the full set.
RUN set -eux; \
    export GITNEXUS_SKIP_OPTIONAL_GRAMMARS=1; \
    git clone --depth 1 https://github.com/chris-husse/GitNexus.git /root/.omc/dependencies/gitnexus; \
    git -C /root/.omc/dependencies/gitnexus fetch --depth 1 origin "${GITNEXUS_REF}"; \
    git -C /root/.omc/dependencies/gitnexus checkout -q FETCH_HEAD; \
    cd /root/.omc/dependencies/gitnexus/gitnexus-shared && npm install --no-audit --no-fund; \
    cd /root/.omc/dependencies/gitnexus/gitnexus && npm ci --no-audit --no-fund && npm run build; \
    node /root/.omc/dependencies/gitnexus/gitnexus/dist/cli/index.js --version

# Pre-bake the local embedding runtime, the embedding model and LadybugDB's
# VECTOR extension (spec 2026-10-27 §9). The two paths MUST equal what
# src/omc/toolctx.py:gitnexus_env derives from OMC_HOME=/root/.omc, so the
# tests' refresh finds them. One `analyze --embeddings` on a throwaway fixture
# downloads the model into HF_HOME and the extension into cached layers; the
# fixture is then `clean --force`d (unregisters it) and removed. Before
# `COPY . /repo` so the layer caches across repo changes.
RUN set -eux; \
    export GITNEXUS_SHARED_STORE=off GITNEXUS_LBUG_EXTENSION_INSTALL=auto; \
    export GITNEXUS_EMBEDDING_RUNTIME_DIR=/root/.omc/dependencies/gitnexus-embeddings/runtime; \
    export HF_HOME=/root/.omc/dependencies/gitnexus-embeddings/hf; \
    CLI=/root/.omc/dependencies/gitnexus/gitnexus/dist/cli/index.js; \
    node "$CLI" embeddings install; \
    test -f "$GITNEXUS_EMBEDDING_RUNTIME_DIR/node_modules/@huggingface/transformers/package.json"; \
    test -f "$GITNEXUS_EMBEDDING_RUNTIME_DIR/node_modules/onnxruntime-node/package.json"; \
    mkdir -p /tmp/embed-fixture && cd /tmp/embed-fixture && git init -q -b main; \
    printf 'def add(a, b):\n    return a + b\n\n\ndef sub(a, b):\n    return a - b\n' > calc.py; \
    printf 'from calc import add\n\n\ndef total(xs):\n    t = 0\n    for x in xs:\n        t = add(t, x)\n    return t\n' > report.py; \
    printf '# fixture\n' > README.md; \
    git -c user.email=e2e@omc.invalid -c user.name="omc e2e" add -A; \
    git -c user.email=e2e@omc.invalid -c user.name="omc e2e" commit -qm fixture; \
    node "$CLI" analyze --skip-agents-md --skip-skills --branch main --embeddings; \
    python3 -c 'import json, pathlib; r = pathlib.Path(".gitnexus"); p = r / "gitnexus.json" if (r / "gitnexus.json").exists() else r / "meta.json"; m = json.loads(p.read_text()); assert m["stats"]["embeddings"] > 0, m'; \
    test -d "$HF_HOME"; \
    node "$CLI" clean --force; \
    cd / && rm -rf /tmp/embed-fixture; \
    test ! -e /root/.gitnexus/embedding-runtime

# the repo under test + omc installed from it
COPY . /repo
# Built from a worktree, /repo/.git is a pointer file to a host path that does
# not exist here, and every git-dependent step (omc's gitnexus proxy, wt)
# refuses the tree. Re-root it as a standalone repo with a main branch and an
# origin/main ref, the shape a primary checkout has.
RUN if [ -f /repo/.git ]; then \
      rm /repo/.git && git -C /repo init -q -b main && git -C /repo add -A && \
      git -C /repo -c user.email="e2e@omc.invalid" -c user.name="omc e2e" \
        commit -qm "e2e source snapshot" && \
      git -C /repo update-ref refs/remotes/origin/main HEAD; \
    fi
ENV UV_TOOL_BIN_DIR=/usr/local/bin
RUN uv tool install /repo

# plugins for Claude Code and Codex (omc from the local repo-marketplace +
# superpowers), baked at build time. The Claude half is idempotent, so its
# test-time call is a verification with no network; the Codex half re-adds
# (its payload check needs the add output).
RUN bash /repo/docker/setup-plugins.sh

# git identity for worktree/commit operations inside scenarios
RUN git config --global user.email "e2e@omc.invalid" && \
    git config --global user.name "omc e2e" && \
    git config --global init.defaultBranch main

WORKDIR /work
CMD ["sleep", "infinity"]
