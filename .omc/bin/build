#!/bin/sh
# This repo's build stage: format check, lint, package build. No tests. A real project
# hook, so it runs with the user's PATH and may call `cat` and `just` by name.
if [ "$#" -eq 1 ] && [ "$1" = "--show-instructions" ]; then
    exec cat "$(dirname "$0")/build.instructions.md"
fi
exec just build "$@"
